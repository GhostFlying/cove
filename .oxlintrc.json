{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    ".cache/**",
    "coverage/**",
    "docs/benchmarks/**",
    "apps/mobile/android/**",
    "apps/mobile/ios/**",
    "apps/mobile/modules/cove-tsnet/generated/**",
    "apps/mobile/modules/cove-tsnet/android/build/**",
    "apps/mobile/modules/cove-tsnet/android/.gradle/**",
    "apps/mobile/src/terminal-document.generated.ts"
  ],
  "rules": {
    "typescript/no-explicit-any": "error"
  }
}
