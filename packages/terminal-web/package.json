{
  "name": "@cove/terminal-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./probes/environment": {
      "types": "./dist/probes/node/environment.d.ts",
      "import": "./dist/probes/node/environment.js"
    },
    "./probes/query-input": {
      "types": "./dist/probes/node/query-input.d.ts",
      "import": "./dist/probes/node/query-input.js"
    }
  },
  "scripts": {
    "build": "tsc -b && pnpm build:browser",
    "build:browser": "vite build --config probes/vite.config.mjs",
    "browser:install": "node probes/install-browser.mjs",
    "test": "pnpm build && pnpm --dir ../.. exec vitest run --project terminal-web-probes",
    "clean": "tsc -b --clean && pnpm clean:browser",
    "clean:browser": "node --input-type=module -e \"import {rm} from 'node:fs/promises'; await rm('dist/browser',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@cove/protocol": "workspace:*",
    "@xterm/xterm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "playwright": "catalog:",
    "vite": "8.3.1"
  }
}
