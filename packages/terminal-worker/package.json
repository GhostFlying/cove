{
  "name": "@cove/terminal-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./native-adapter": {
      "types": "./dist/src/native-pty.d.ts",
      "import": "./dist/src/native-pty.js"
    },
    "./qualification": {
      "types": "./dist/src/native-qualification.d.ts",
      "import": "./dist/src/native-qualification.js"
    },
    "./execution": {
      "types": "./dist/src/worker-execution.d.ts",
      "import": "./dist/src/worker-execution.js"
    },
    "./pipe": {
      "types": "./dist/src/pipe-endpoint.d.ts",
      "import": "./dist/src/pipe-endpoint.js"
    }
  },
  "bin": {
    "cove-terminal-worker": "./dist/src/main.js"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "pnpm build && pnpm --dir ../.. exec vitest run --project terminal-worker",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@cove/protocol": "workspace:*",
    "@cove/terminal-engine": "workspace:*",
    "node-pty": "catalog:"
  },
  "devDependencies": {
    "@types/node": "26.6.2"
  }
}
