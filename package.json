{
  "name": "cove",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "26.10.0",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @cove/terminal-web --fail-if-no-match build:browser",
    "typecheck": "tsc -b",
    "native:prepare": "node scripts/node-pty-install.mjs",
    "clean": "tsc -b --clean && pnpm --filter @cove/terminal-web --fail-if-no-match clean:browser",
    "lint": "oxlint --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/ci-test-gate.mjs",
    "test:watch": "vitest",
    "check": "pnpm native:prepare && pnpm format:check && pnpm lint && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "oxlint": "1.85.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
