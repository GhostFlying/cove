{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "lib": ["ES2024", "DOM"],
    "skipLibCheck": true,
    "outDir": "dist",
    "tsBuildInfoFile": ".cache/ports.tsbuildinfo"
  },
  "include": [
    "src/codec.ts",
    "src/native-ports.ts",
    "src/entry.ts",
    "src/pairing.ts",
    "src/credentials.ts",
    "src/lifecycle.ts",
    "src/observation.ts",
    "src/local-store.ts",
    "src/operation-store.ts",
    "src/mobile-host.ts",
    "src/navigation.ts",
    "src/presentation.ts",
    "src/action-error.ts",
    "src/read-observation.ts"
  ],
  "references": [
    {
      "path": "../../packages/protocol"
    },
    {
      "path": "../../packages/client"
    }
  ]
}
